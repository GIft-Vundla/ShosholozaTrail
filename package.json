{
  "name": "shosholoza-trail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.js",
    "security:scan": "node scripts/scan-secrets.mjs",
    "test:browser": "playwright test",
    "harness:r3": "node harness/run-traces.js",
    "harness:ai": "node harness/ai-eval.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "leaflet": "^1.9.4"
  }
}
